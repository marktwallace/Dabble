# Analytic database (DuckDB)
DUCKDB_ANALYTIC_FILE=db/analytic.duckdb

# LLM
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Knowledge base embeddings
OPENAI_API_KEY=your_key_here

# Optional: SQL query to read a freshness timestamp from the analytic DB
# Result is shown on the entry screen so the analyst knows how current the data is
# DB_TIMESTAMP_QUERY=SELECT max(updated_at) FROM etl_log

# Optional: text added to the system prompt after the date line
# Use it to tell the model which instance or environment it is running in
# INSTANCE_CONTEXT="Environment: staging. This instance reads the staging database."

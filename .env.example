# Analytic database: set exactly one of the three modes below.

# 1. A DuckDB file
DUCKDB_ANALYTIC_FILE=db/analytic.duckdb
# Optional: open the file read-only (1 / true / yes)
# DUCKDB_READ_ONLY=true

# 2. A DuckLake on S3: the catalog is downloaded from s3://<bucket>/<prefix>/catalog.duckdb
# at start and on /refresh; data is read from s3://<bucket>/<prefix>/data/
# DABBLE_S3_BUCKET=my-bucket
# DABBLE_S3_PREFIX=prod
# Required in both DuckLake modes: the catalog alias the writer used
# DABBLE_DB_NAME=analytics

# 3. A DuckLake synced to a local directory (catalog.duckdb + data/)
# DABBLE_DATA_PATH=/path/to/lake
# DABBLE_DB_NAME=analytics

# Optional, any mode: more DuckLake catalogs attached read-only beside the main database,
# comma-separated name=<catalog>, each attached as ATTACH 'ducklake:<catalog>' AS name, so
# its data path is the one recorded in it. Queried as <name>.<table>. A catalog file on S3
# (s3://...) is downloaded first; any other value is passed to ATTACH as is.
# DABBLE_EXTRA_CATALOGS=extra=s3://my-bucket/other/catalog.duckdb,local=/path/to/catalog.duckdb

# LLM
ANTHROPIC_API_KEY=your_key_here
# Required: the model every request uses, e.g. claude-opus-5-5. There is no default.
CLAUDE_MODEL=
# Optional: effort level (low / medium / high / xhigh / max). Unset uses the model's default.
# CLAUDE_EFFORT=medium
# Optional, for models that tie thinking blocks to their conversation (e.g. claude-opus-5-5):
# drop earlier thinking blocks a resumed conversation no longer matches, instead of failing.
# CLAUDE_THINKING_BLOCK_BINDING=drop_block

# Optional: SQL query to read a freshness timestamp from the analytic DB (file mode;
# DuckLake modes use the latest snapshot time)
# Result is shown on the entry screen so the analyst knows how current the data is
# DB_TIMESTAMP_QUERY=SELECT max(updated_at) FROM etl_log

# Optional: text added to the system prompt after the date line
# Use it to tell the model which instance or environment it is running in
# INSTANCE_CONTEXT="Environment: staging. This instance reads the staging database."

# Optional: directories (defaults shown). PROMPTS_DIR holds system_prompt.md and the
# documents read_document reads; point it at an overlay's prompt directory.
# PROMPTS_DIR=prompts
# KNOWLEDGE_DIR=knowledge
# CONVERSATIONS_DIR=conversations
# UPLOADS_DIR=uploads
# REPORTS_DIR=reports
# NOTEBOOKS_DIR=notebooks
